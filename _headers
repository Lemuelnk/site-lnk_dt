/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Report-To: {"group":"csp-endpoint","max_age":604800,"endpoints":[{"url":"https://lnk-studio.com/api/csp-report"}]}
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com 'sha256-/YzSxpMFoLj99AyHdbLGTg0xCaqrk1MROCOJAitn1bE=' 'sha256-wAzdTAvLh0p6w5/uaitQbc4rP2o+grhmin3cX3gBPVc='; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  NEL: {"report_to":"csp-endpoint","success_fraction":0,"max_age":604800}

/
  Cache-Control: public, max-age=300, must-revalidate
  CDN-Cache-Control: public, max-age=300
/index.html
  Cache-Control: public, max-age=300, must-revalidate
  CDN-Cache-Control: public, max-age=300
/brand
  Cache-Control: public, max-age=300, must-revalidate
  CDN-Cache-Control: public, max-age=300
/brand.html
  Cache-Control: public, max-age=300, must-revalidate
  CDN-Cache-Control: public, max-age=300
/mentions-legales.html
  Cache-Control: public, max-age=300, must-revalidate
  CDN-Cache-Control: public, max-age=300
/politique-confidentialite.html
  Cache-Control: public, max-age=300, must-revalidate
  CDN-Cache-Control: public, max-age=300

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=300, must-revalidate
  CDN-Cache-Control: public, max-age=300

/css/site.bundle.*.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/css/legal.bundle.*.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/css/admin-reviews.*.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/js/site.bundle.*.js
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/admin/*
  X-Robots-Tag: noindex, nofollow

/api/csp-report
  X-Robots-Tag: noindex, nofollow
